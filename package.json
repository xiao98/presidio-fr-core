{
  "name": "presidio-fr-core",
  "version": "0.1.0",
  "description": "Local privacy gateway: masks French PII in LLM API requests before they leave the machine, restores it in streamed replies.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "presidio-fr-core": "src/cli.mjs"
  },
  "scripts": {
    "sync": "node scripts/sync-engine.mjs",
    "start": "node src/cli.mjs",
    "test": "node --test test/unit.test.mjs test/gateway.test.mjs test/panel.test.mjs",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux",
    "test:desktop": "node --test test/desktop.test.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0"
  },
  "main": "desktop/main.cjs",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0"
  }
}
